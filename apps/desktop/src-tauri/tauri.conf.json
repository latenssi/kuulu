{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kuulu",
  "version": "../package.json",
  "identifier": "fi.latenssi.kuulu",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Kuulu",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1N0JERTY5REQwQTg1NTYKUldSV2hRcmRhZDU3eGJnWjF0QjlWZmJFUmZadXdyQkdYWXlzMFpsQk1pZjhObGU3ZFVCTGpIMHUK"
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "kuulu"
        ]
      }
    }
  }
}
