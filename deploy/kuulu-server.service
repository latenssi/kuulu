# systemd unit for the kuulu-server binary. See docs/SERVER.md.
#   useradd --system --home-dir /var/lib/kuulu-server --shell /usr/sbin/nologin kuulu
#   install -m 755 kuulu-server /usr/local/bin/
#   cp kuulu-server.service /etc/systemd/system/
#   systemctl enable --now kuulu-server
#   journalctl -u kuulu-server        # fingerprint and first admin invite
#   sudo -u kuulu kuulu-server invite --uses 10 /var/lib/kuulu-server
# Data and kuulu.toml live in /var/lib/kuulu-server.
[Unit]
Description=Kuulu voice chat server
Documentation=https://github.com/latenssi/kuulu/blob/main/docs/SERVER.md
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/kuulu-server /var/lib/kuulu-server
# Clean shutdown (closes connections, flushes the database) is on SIGINT.
KillSignal=SIGINT
Restart=on-failure
RestartSec=5s

# A dedicated user rather than DynamicUser, so the invite command can run
# as the same user against the same files.
User=kuulu
Group=kuulu
StateDirectory=kuulu-server
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
